<AutoPilot:solution xmlns:AutoPilot="com.autoesl.autopilot.solution">
    <name>
        <value string="hls"/>
    </name>
    <project>
        <value string="DeepWaveAccel"/>
    </project>
    <flowTarget value="vivado"/>
    <targetInfo>
        <TargetInfo value="xck26:-sfvc784:-2LV-c"/>
    </targetInfo>
    <libraryList>
        <library value="xilinx/zynquplus/zynquplus" name="DefaultPlatform"/>
    </libraryList>
    <clockList>
        <clock name="default" period="100mhz" default="false" uncertainty="15%"/>
    </clockList>
    <config>
        <config_cosim disable_deadlock_detection="1" wave_debug="1"/>
        <config_csim code_analyzer="0"/>
        <config_export display_name="DeepWave" ipname="DeepWave" output="C:/Users/Bram/Documents/Git/DeepWaveAccel/Hardware/vitis/DeepWaveAccel/ip/kernel.xo" format="ip_catalog" vivado_clock="100MHz" rtl="verilog"/>
        <config_sim O="1" ldflags="-I ./include/"/>
        <config_rtl deadlock_detection="none"/>
    </config>
    <writeConfigIni value="0"/>
    <isComponent value="1"/>
</AutoPilot:solution>

